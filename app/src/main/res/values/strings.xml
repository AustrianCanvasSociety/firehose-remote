<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Firehose Remote</string>

    <!-- Scan -->
    <string name="scan_button">Scan for TVs</string>
    <!-- Shown once, before the Scan button, to someone who has never paired. The
         two things a first-time user cannot guess, and nothing else. -->
    <string name="first_run_heading">Before you scan</string>
    <string name="first_run_body">Your phone has to be on the same Wi-Fi as the TV. When you pair, the TV shows a PIN — read it off the TV screen and type it here, once.</string>
    <string name="first_run_button">Got it</string>

    <string name="scan_again_button">Scan again</string>
    <string name="scanning">Looking for fire TVs on your network…</string>
    <string name="no_devices">No fire TVs found. Make sure the TV is on and on the same Wi-Fi network as this phone.</string>
    <string name="vpn_may_block">A VPN is on. It can keep this phone off your home network — turn it off, or allow local network access in the VPN app, then scan again.</string>
    <string name="host_did_not_answer">Something on this network took the connection and then went quiet. That is usually a TV that is not answering — turn it on with its own remote, then scan again.</string>
    <string name="device_not_answering">%1$s (not answering)</string>
    <string name="cancel_wake_button">Cancel</string>
    <string name="unexpected_failure">Something went wrong and that did not finish. Try again — if it keeps happening, close the app and open it again.</string>
    <string name="host_refused">Something on this network refused the connection, so nothing is listening where the TV\'s control API should be. An idle fire TV looks like this — turn it on with its own remote, then scan again.</string>
    <string name="found_devices">fire TVs found</string>

    <!-- The manual route to a TV the scan cannot find. It shows on both the
         empty-scan screen and the did-not-answer screen, so it is worded to
         stand on its own rather than to continue either sentence above. -->
    <string name="address_prompt">You can also type the TV\'s IP address and connect to it directly.</string>
    <string name="address_hint">192.0.2.22</string>
    <string name="address_button">Connect to this address</string>

    <!-- Pairing -->
    <string name="pin_prompt">Type the PIN shown on your TV</string>
    <string name="pin_hint">PIN</string>
    <string name="pair_button">Pair</string>
    <string name="pairing_state">Pairing…</string>
    <string name="back_button">Back</string>
    <string name="pairing_failed">Pairing failed</string>
    <string name="try_again_button">Try again</string>
    <string name="scan_for_another_button">Scan for another TV</string>
    <string name="forget_button">Forget this TV</string>
    <!-- Forget asks first: it is the only overflow entry that destroys a
         pairing, and the pairing is what took a walk to the TV to set up. The
         confirm button is its own string so the dialog can say "Forget" without
         renaming the menu entry it came from. -->
    <string name="forget_dialog_title">Forget this TV?</string>
    <string name="forget_dialog_body">%1$s will be removed from this app. You can pair it again with the PIN shown on the TV.</string>
    <string name="forget_confirm_button">Forget</string>

    <!-- Multi-TV pairing (Phase 3 Step 9). The switch submenu heading and the
         single-other-TV top-level shape, plus two suffix strings that annotate
         list entries — one for the scan list and one for the overflow's
         submenu rows. Suffixes are format strings so the device name reads
         verbatim without leading-space concatenation. -->
    <string name="switch_to_tv_menu">Switch to TV</string>
    <string name="action_switch_to_named_tv">Switch to %1$s</string>
    <!-- A scan row whose name another row also carries. The address is what
         tells the two apart; it sits inside the name, so the answering and
         paired suffixes wrap it rather than the other way round. -->
    <string name="scan_list_name_with_address">%1$s (%2$s)</string>
    <string name="scan_list_paired_suffix">%1$s (paired)</string>
    <string name="overflow_current_suffix">%1$s (current)</string>

    <!-- Options overflow menu, from the top-bar `⋯` icon on the paired screen. -->
    <string name="menu_about">About</string>
    <!-- Overflow toggle: the volume rocker shows ＋ / − until this is checked. -->
    <string name="menu_word_labels">Word labels</string>
    <string name="menu_theme">Theme</string>
    <string name="theme_style">Style</string>
    <string name="theme_mode">Light or dark</string>
    <string name="theme_accent">Accent</string>
    <string name="theme_apply">Apply</string>
    <string name="theme_style_plate">Plate</string>
    <string name="theme_style_gradient">Gradient</string>
    <string name="theme_mode_light">Light</string>
    <string name="theme_mode_dark">Dark</string>
    <string name="about_dialog_title">Firehose Remote</string>
    <string name="about_dialog_body">A minimal, open-source, hand-rolled Android remote for fire TV. Distributed via F-Droid. Zero runtime dependencies.\n\nVersion %1$s\n\nSource: https://github.com/AustrianCanvasSociety/firehose-remote</string>
    <!-- Accessibility label for the `⋯` overflow icon in the paired-screen top-bar. -->
    <string name="remote_overflow_button">More options</string>

    <!-- Remote. Prefixed so none of these can collide with the flow's own
         labels — `back_button` above is the pairing screen's Back control.
         Each string is the control's spoken name as well as its drawn one: a
         screen reader reads this and nothing else, so it has to be a name a
         person can act on. The four directions were `▲ ▼ ◀ ▶` and announced a
         character rather than a direction. Nothing on screen wanted the symbol
         — the ring draws arcs and labels only the disc, with "OK" — so the
         symbol had no reader but the announcement, which it broke. -->
    <string name="remote_up_button">Up</string>
    <string name="remote_down_button">Down</string>
    <string name="remote_left_button">Left</string>
    <string name="remote_right_button">Right</string>
    <string name="remote_select_button">Select</string>
    <string name="remote_home_button">Home</string>
    <string name="remote_back_button">Back</string>
    <string name="remote_menu_button">Options</string>
    <string name="remote_play_pause_button">Play/Pause</string>

    <!-- Step 3's controls. `remote_power_button` is the one no build draws: the
         device's power action was captured going out, but no capture recorded
         what it did, so its descriptor is absent and the label exists only
         because a descriptor is total. Rewind and Forward ship as a matched
         pair — one captured, one inferred — because shipping only the rewind
         half makes an overshoot uncorrectable. -->
    <string name="remote_volume_up_button">Vol +</string>
    <string name="remote_volume_down_button">Vol −</string>
    <string name="remote_mute_button">Mute</string>
    <string name="remote_power_button">Power</string>
    <string name="remote_rewind_button">Rewind</string>
    <string name="remote_forward_button">Forward</string>
    <string name="remote_sleep_button">Sleep</string>
</resources>
